# Smart-Evac Environment Configuration
# Copy this file to .env and insert your real credentials before running external tools.

# Google Gemini API Key (Required for Mode C Live AI supervisor)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Target Gemini Model Identifier
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# API Call Timeout in seconds (Unity circuit breaker triggers at 2.5s)
API_TIMEOUT_SECONDS=2.5

# Analysis and Telemetry Data Configuration
EXPERIMENT_DATA_PATH=./ExperimentData.csv
SAMPLE_DATA_PATH=./analysis/sample_ExperimentData.csv
